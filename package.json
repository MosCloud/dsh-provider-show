{
  "name": "dsh-provider-show",
  "version": "0.1.0",
  "description": "Shows which provider the selected model belongs to in the composer row, and stays silent for providers another plugin already presents.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./ownership": "./lib/ownership.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/ownership.js && node scripts/verify.mjs && node --test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "provider",
    "composer"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "author": {
    "name": "MosCloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosCloud/dsh-provider-show.git"
  },
  "homepage": "https://github.com/MosCloud/dsh-provider-show#readme",
  "bugs": {
    "url": "https://github.com/MosCloud/dsh-provider-show/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
